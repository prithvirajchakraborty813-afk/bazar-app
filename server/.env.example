# Copy this file to .env and fill in real values. Never commit .env.

# Get this from neon.tech project dashboard -> Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Password for the admin login (change this)
ADMIN_PASSWORD=admin123

# Get this free at https://console.groq.com/keys — no credit card required.
# Used for both speech-to-text (/api/transcribe, Whisper) and parsing voice
# commands into actions (/api/voice-command, Llama 3.3 70B).
GROQ_API_KEY=your-groq-api-key

# Port the server runs on
PORT=3001
