# Copy this file to .env and fill in real values. Never commit .env.

# Get this from neon.tech project dashboard -> Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Password for the admin login (change this)
ADMIN_PASSWORD=admin123

# Get this from https://build.nvidia.com after creating an NVIDIA NIM API key
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which NIM model to use for parsing voice commands
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Port the server runs on
PORT=3001
